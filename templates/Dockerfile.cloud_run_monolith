# Cloud Run monolith: nginx :$PORT serves Flutter web + proxies API/WS → Serverpod :8081
# Build context: monorepo root (after `podfly` has run `flutter build web` → build/web).
# Placeholders: {{SERVER_DIR}}

FROM dart:3.10.3 AS server
WORKDIR /app
COPY pubspec.lock .
COPY {{SERVER_DIR}} {{SERVER_DIR}}
RUN printf '%s\n' \
  'name: _' \
  'environment:' \
  '  sdk: ^3.10.3' \
  'workspace:' \
  '  - {{SERVER_DIR}}' \
  > pubspec.yaml
RUN dart pub get
WORKDIR /app/{{SERVER_DIR}}
RUN dart build cli --target bin/main.dart --output build \
  && mv build/bundle/bin/main build/bundle/bin/server \
  && mkdir -p config web migrations

FROM nginx:1.27-alpine
RUN apk add --no-cache libstdc++ ca-certificates netcat-openbsd \
  && rm -rf /var/cache/apk/*

WORKDIR /app
ENV runmode=production
ENV serverid=default
ENV logging=normal
ENV role=monolith

COPY --from=server /runtime/ /
COPY --from=server /app/{{SERVER_DIR}}/build/bundle/ ./
COPY --from=server /app/{{SERVER_DIR}}/config/ config/
# Mini Serverpod templates register StaticRoute on web/static at startup — must exist.
COPY --from=server /app/{{SERVER_DIR}}/web/ web/
COPY --from=server /app/{{SERVER_DIR}}/migrations/ migrations/
RUN mkdir -p web/static web/app migrations
COPY --from=server /app/{{SERVER_DIR}}/lib/src/generated/protocol.yaml \
  lib/src/generated/protocol.yaml

# Pre-built by podfly (WebBuilder) into monorepo build/web
COPY build/web /app/public

COPY deploy/nginx.cloud_run_monolith.conf /etc/nginx/conf.d/default.conf
COPY deploy/start.cloud_run_monolith.sh /app/start.sh
RUN chmod +x /app/start.sh

EXPOSE 8080
CMD ["/app/start.sh"]
